#!/usr/bin/env bash
# Generate tmux color config from pywal colors.json
COLORS="$HOME/.cache/wal/colors.json"
OUT="$HOME/.config/tmux/colors.conf"

if [ ! -f "$COLORS" ]; then
    echo '{"error": "no pywal colors"}' >&2
    exit 1
fi

bg=$(jq -r '.special.background' "$COLORS")
fg=$(jq -r '.special.foreground' "$COLORS")
c0=$(jq -r '.colors.color0' "$COLORS")
c1=$(jq -r '.colors.color1' "$COLORS")
c2=$(jq -r '.colors.color2' "$COLORS")
c3=$(jq -r '.colors.color3' "$COLORS")
c4=$(jq -r '.colors.color4' "$COLORS")
c5=$(jq -r '.colors.color5' "$COLORS")
c6=$(jq -r '.colors.color6' "$COLORS")
c7=$(jq -r '.colors.color7' "$COLORS")

cat > "$OUT" << EOF
# Auto-generated by pywal-tmux — do not edit

set -g status-left "#[fg=${bg},bg=${c4}]   #S #[default]"
set -g status-right "#[fg=${bg},bg=${c4}]  %H:%M  %d.%m.%Y  #[default]"
set -g window-status-format "#[fg=${fg},bg=${bg}] #I:#W "
set -g window-status-current-format "#[fg=${bg},bg=${c4}] #I:#W "
set -g window-status-activity-style "fg=${c1},bg=${bg}"
set -g pane-border-style "fg=${c1},bg=${bg}"
set -g pane-active-border-style "fg=${c4},bg=${bg}"
set -g message-style "fg=${fg},bg=${c4}"
set -g message-command-style "fg=${fg},bg=${bg}"
set -g mode-style "fg=${bg},bg=${c6}"
EOF

echo "tmux colors generated ($OUT)"
