#!/usr/bin/env bash
# Decode QR code from screenshot

TMP=$(mktemp /tmp/qr-XXXXXX.png)
hyprshot -m region -o /tmp -f "$(basename "$TMP")" 2>/dev/null
[ ! -f "$TMP" ] && exit 1

result=$(zbarimg "$TMP" 2>/dev/null)
rm -f "$TMP"

if [ -n "$result" ]; then
    echo "$result" | sed 's/^[^:]*://'
    echo "$result" | sed 's/^[^:]*://' | wl-copy
    notify-send "QR Code" "Decoded and copied to clipboard"
else
    notify-send "QR Code" "No QR code found"
fi
