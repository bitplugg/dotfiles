#!/usr/bin/env bash
# Waybar quicksettings menu via wofi

vol=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf "%d", $2 * 100}')
mic=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED && echo " muted" || echo " unmuted")
night=$(pgrep wlsunset >/dev/null && echo " on" || echo " off")
idle=$([ -f /tmp/hypridle_inhibited ] && echo " off" || echo "ﾪ on")
br=$(brightnessctl g 2>/dev/null)
bm=$(brightnessctl m 2>/dev/null)
brp=$((br * 100 / bm 2>/dev/null))

choice=$(printf "Volume   %d%%\nBrightness   %d%%\nMic %s\nNight mode %s\nIdle %s\nPower menu ⏻" \
    "$vol" "$brp" "$mic" "$night" "$idle" | \
    wofi --dmenu -p "Quick Settings")

case "$choice" in
    Volume*) printf '+5%%\n-5%%\nToggle mute' | wofi --dmenu -p "Volume $vol%" | while read -r a; do
        case "$a" in
            +5*) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ ;;
            -5*) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
            *mute*) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
        esac
    done ;;
    Brightness*) printf '+5%%\n-5%%' | wofi --dmenu -p "Brightness $brp%" | while read -r a; do
        case "$a" in
            +5*) brightnessctl s +5% ;;
            -5*) brightnessctl s 5%- ;;
        esac
    done ;;
    Mic*) ~/.local/bin/mic-toggle ;;
    Night*) ~/.local/bin/night-mode ;;
    Idle*) ~/.local/bin/idle-inhibit ;;
    Power*) ~/.local/bin/powermenu ;;
esac
