#!/usr/bin/env bash
# USB/drive mount manager via wofi

ACTION=$(printf "  Mount\n  Unmount\n  Refresh" | wofi --dmenu -p "Mount" 2>/dev/null)
[ -z "$ACTION" ] && exit 0

case "$ACTION" in
    *Mount*)
        DEVICES=$(lsblk -o NAME,SIZE,TYPE,MOUNTPOINT,LABEL 2>/dev/null | grep -E "part|disk" | grep -v "loop" | grep -v "├─\|└─")
        [ -z "$DEVICES" ] && DEVICES="No devices found"
        CHOICE=$(echo "$DEVICES" | wofi --dmenu -p "Select device" 2>/dev/null)
        [ -z "$CHOICE" ] && exit 0
        DEV=$(echo "$CHOICE" | awk '{print "/dev/"$1}')
        MNT=$(udisksctl mount -b "$DEV" 2>&1)
        notify-send "Mount" "$MNT" ;;
    *Unmount*)
        MOUNTED=$(mount | grep "^/dev" | grep -v "nvme\|sda[0-9]" | awk '{print $1}')
        [ -z "$MOUNTED" ] && MOUNTED="Nothing to unmount"
        CHOICE=$(echo "$MOUNTED" | wofi --dmenu -p "Unmount" 2>/dev/null)
        [ -z "$CHOICE" ] && exit 0
        UMOUNT=$(udisksctl unmount -b "$CHOICE" 2>&1)
        notify-send "Unmount" "$UMOUNT" ;;
    *Refresh*) notify-send "Mount" "Refreshed" ;;
esac
