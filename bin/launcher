#!/usr/bin/env bash
# Категоризированный лаунчер: системные приложения + скрипты

WALLPAPER=$(cat ~/.cache/wal/wal 2>/dev/null)
WOFI_DIR="$HOME/.config/wofi"
mkdir -p "$WOFI_DIR"
BANNER="/tmp/wofi-banner.png"
[ -n "$WALLPAPER" ] && [ -f "$WALLPAPER" ] && convert "$WALLPAPER" -resize 500x90^ -gravity center -extent 500x90 "$BANNER" 2>/dev/null

WOFI_CSS="$WOFI_DIR/launcher.css"
BGURL=""
[ -f "$BANNER" ] && BGURL="background-image: url('$BANNER');"
cat > "$WOFI_CSS" << CSS
#window { background-color: rgba(0,0,0,0.92); border-radius: 14px; border: 1px solid rgba(255,255,255,0.08); }
#input { margin: 8px 14px 4px; padding: 10px 14px; border-radius: 8px; background-color: rgba(255,255,255,0.08); color: #fff; font-size: 14px; }
#inner-box { margin: 0 14px 12px; }
#outer-box { padding-top: 105px; $BGURL background-size: 500px 90px; background-position: top center; background-repeat: no-repeat; }
#text { color: #fff; padding: 6px 4px; font-size: 13px; }
#entry { padding: 8px 12px; border-radius: 6px; margin: 1px 0; }
#entry:selected { background-color: rgba(137,180,250,0.2); }
#entry:selected #text { font-weight: bold; }
CSS

# ── Collect .desktop apps ─────────────────
CACHE="/tmp/wofi-apps.cache"
if [ ! -f "$CACHE" ] || [ "$(find /usr/share/applications ~/.local/share/applications -name '*.desktop' -newer "$CACHE" 2>/dev/null | head -1)" ]; then
    > "$CACHE"
    for dir in /usr/share/applications ~/.local/share/applications; do
        [ -d "$dir" ] || continue
        for f in "$dir"/*.desktop; do
            [ -f "$f" ] || continue
            grep -q "^NoDisplay=true" "$f" 2>/dev/null && continue
            NAME=$(grep -m1 "^Name=" "$f" 2>/dev/null | cut -d= -f2-)
            EXEC=$(grep -m1 "^Exec=" "$f" 2>/dev/null | cut -d= -f2- | sed 's/%.//g' | awk '{print $1}')
            CATS=$(grep -m1 "^Categories=" "$f" 2>/dev/null | cut -d= -f2-)
            TERM=$(grep -m1 "^Terminal=" "$f" 2>/dev/null | cut -d= -f2-)
            [ -z "$NAME" ] || [ -z "$EXEC" ] && continue
            echo "$NAME|$EXEC|$CATS" >> "$CACHE"
        done
    done
fi

# ── Categorize into files ─────────────────
mkdir -p /tmp/wofi-cats
rm -f /tmp/wofi-cats/*

# Category mapping
cat_to_file() {
    local cats="$1" name="$2" execp="$3"
    local f="tools"
    for c in $(echo "$cats" | tr ';' '\n'); do
        case "$c" in
            Network|WebBrowser) f="internet"; break ;;
            Development|TextEditor) f="dev"; break ;;
            System|Settings|Hardware) f="system"; break ;;
            Utility|Accessibility) f="tools"; break ;;
            Graphics|AudioVideo|Player|Video) f="media"; break ;;
            Game) f="games"; break ;;
            Office|Database|Finance) f="office"; break ;;
            TerminalEmulator) f="terminal"; break ;;
            FileManager|Filesystem) f="files"; break ;;
        esac
    done
    echo "$name|$execp" >> /tmp/wofi-cats/$f
}

while IFS='|' read -r NAME EXEC CATS; do
    cat_to_file "$CATS" "$NAME" "$EXEC"
done < "$CACHE"

# Also add custom scripts
for s in ~/.local/bin/*; do
    [ -f "$s" ] && [ -x "$s" ] || continue
    echo "$(basename $s)|$(basename $s)" >> /tmp/wofi-cats/scripts
done

# Add AI
echo "ai|ai" >> /tmp/wofi-cats/ai
echo "ai-explain|ai-explain" >> /tmp/wofi-cats/ai

# Add Power
echo "powermenu|powermenu" >> /tmp/wofi-cats/power
echo "lock|lock" >> /tmp/wofi-cats/power
echo "suspend|suspend" >> /tmp/wofi-cats/power
echo "hibernate|hibernate" >> /tmp/wofi-cats/power
echo "reboot|reboot" >> /tmp/wofi-cats/power
echo "shutdown|shutdown" >> /tmp/wofi-cats/power

# Clean up empty categories
for f in /tmp/wofi-cats/*; do
    [ -s "$f" ] || rm -f "$f"
done

# ── First menu: categories ────────────────
declare -A CAT_ICONS
CAT_ICONS[terminal]="  Terminal"
CAT_ICONS[files]="  Files"
CAT_ICONS[scripts]="󱕍  Scripts"
CAT_ICONS[system]="  System"
CAT_ICONS[internet]="󰛳  Internet"
CAT_ICONS[media]="󰝚  Media"
CAT_ICONS[dev]="󰄛  Dev"
CAT_ICONS[tools]="  Tools"
CAT_ICONS[games]="󰋚  Games"
CAT_ICONS[office]="󰈙  Office"
CAT_ICONS[ai]="  AI"
CAT_ICONS[power]="  Power"

MENU_CATS=()
CAT_NAMES=()
for f in /tmp/wofi-cats/*; do
    key=$(basename "$f")
    icon="${CAT_ICONS[$key]}"
    [ -z "$icon" ] && icon="  $key"
    MENU_CATS+=("$icon")
    CAT_NAMES+=("$key")
done

CHOICE=$(printf '%s\n' "${MENU_CATS[@]}" | wofi --dmenu -p "" -W 420 -H 480 --style "$WOFI_CSS" 2>/dev/null)
[ -z "$CHOICE" ] && exit 0

# Find selected category file
CAT_KEY=""
for i in "${!MENU_CATS[@]}"; do
    if [ "${MENU_CATS[$i]}" = "$CHOICE" ]; then
        CAT_KEY="${CAT_NAMES[$i]}"
        break
    fi
done
[ -z "$CAT_KEY" ] && notify-send "Launcher" "Category not found" && exit 0

# ── Second menu: apps in category ─────────
APPS_LIST=$(cat /tmp/wofi-cats/"$CAT_KEY" 2>/dev/null)
[ -z "$APPS_LIST" ] && notify-send "Launcher" "Empty category" && exit 0

SECOND=$(echo "$APPS_LIST" | wofi --dmenu -p "" -W 500 -H 520 --style "$WOFI_CSS" 2>/dev/null)
[ -z "$SECOND" ] && exit 0

APP=$(echo "$SECOND" | awk -F'|' '{print $2}' | xargs)

# ── Launch ─────────────────────────────────
case "$APP" in
    kitty|htop|lazygit|btop|ncmpcpp|ncdu|yazi|tmux-sessionizer|tmux|nvim)
        kitty -e "$APP" ;;
    dolphin|thunar) "$APP" ;;
    firefox|brave|mpv) "$APP" ;;
    lock) hyprlock ;;
    suspend) systemctl suspend ;;
    hibernate) systemctl hibernate ;;
    reboot) systemctl reboot ;;
    shutdown) systemctl poweroff ;;
    ai) kitty --class=floating-term -e ~/.local/bin/ai ;;
    ai-explain) kitty --class=floating-term -e ~/.local/bin/ai-explain ;;
    powermenu) ~/.local/bin/powermenu ;;
    *)
        if [ -f ~/.local/bin/"$APP" ]; then ~/.local/bin/"$APP"
        elif command -v "$APP" &>/dev/null; then "$APP"
        else notify-send "Launcher" "Unknown: $APP"; fi ;;
esac
