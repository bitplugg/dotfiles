#!/usr/bin/env bash
# Launcher/manager for AGS bar
ACTION="${1:-toggle}"
INSTANCE="ags"

case "$ACTION" in
    start)
        if ags list 2>/dev/null | grep -q "^${INSTANCE}$"; then
            echo "AGS bar already running"
        else
            cd ~/.config/ags && ags run app.tsx &
            disown
        fi
        ;;
    stop)
        ags quit "$INSTANCE" 2>/dev/null || true
        ;;
    restart)
        ags quit "$INSTANCE" 2>/dev/null
        sleep 0.5
        cd ~/.config/ags && ags run app.tsx &
        disown
        ;;
    toggle)
        if ags list 2>/dev/null | grep -q "^${INSTANCE}$"; then
            exec "$0" stop
        else
            exec "$0" start
        fi
        ;;
    status)
        if ags list 2>/dev/null | grep -q "^${INSTANCE}$"; then
            echo " AGS: running"
        else
            echo " AGS: stopped"
        fi
        ;;
    *)
        echo "Usage: ags-launcher {start|stop|restart|toggle|status}"
        exit 1
        ;;
esac
