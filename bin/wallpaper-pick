#!/usr/bin/env bash
# Floating terminal wallpaper picker using fzf + chafa preview

WALLPAPER_DIR="$HOME/Pictures/wallpapers"

if [ ! -d "$WALLPAPER_DIR" ]; then
    echo "Directory $WALLPAPER_DIR does not exist" >&2
    exit 1
fi

# Build file list
mapfile -d '' FILES < <(
    find "$WALLPAPER_DIR" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.webp' \) -print0 | sort -z
)

if [ ${#FILES[@]} -eq 0 ]; then
    echo "No images found in $WALLPAPER_DIR" >&2
    exit 1
fi

SELECTED=$(printf '%s\n' "${FILES[@]}" | fzf \
    --preview='chafa --symbols block --size 50x30 {}' \
    --preview-window='right:55%' \
    --height=80% \
    --layout=reverse \
    --border \
    --prompt='Wallpaper > ' \
    --header='Select wallpaper (ESC to quit)' \
    --with-nth=1 \
)

if [ -n "$SELECTED" ]; then
    exec ~/.local/bin/wallpaper "$SELECTED"
fi
