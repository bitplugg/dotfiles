SELECTED=$(echo "$EMOJIS" | ~/.local/bin/dmenu -p "Emoji" -theme-str 'listview {columns: 5;}')
[ -z "$SELECTED" ] && exit 0
EMOJI=$(echo "$SELECTED" | awk '{print $1}')
echo -n "$EMOJI" | wl-copy
notify-send "Emoji" "Copied: $EMOJI"
