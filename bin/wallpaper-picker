#!/usr/bin/env python3
import os
import subprocess
import tkinter as tk
from tkinter import ttk
from PIL import Image, ImageTk
import glob

HOME = os.path.expanduser("~")
WALL_DIR = os.path.join(HOME, "Pictures", "wallpapers")
THUMB_SIZE = (200, 120)

def set_wallpaper(path):
    subprocess.Popen(f"awww img '{path}' --transition-fps 60 --transition-duration 2", shell=True)
    subprocess.Popen(f"wal -i '{path}' -n -q", shell=True)
    subprocess.Popen(f"{HOME}/.local/bin/pywal-update-all", shell=True)

class WallpaperPicker:
    def __init__(self):
        self.root = tk.Tk(className="wallpaper-picker")
        self.root.title("Wallpaper")
        self.root.after(200, self._float_window)

        self.bg = "#1e1e2e"
        self.fg = "#cdd6f4"
        self.accent = "#89b4fa"
        self.root.configure(bg=self.bg)

        style = ttk.Style()
        style.theme_use("clam")
        style.configure("TFrame", background=self.bg)
        style.configure("TLabel", background=self.bg, foreground=self.fg,
            font=("JetBrainsMono Nerd Font", 11))
        style.configure("TButton", background=self.accent, foreground="#000000",
            font=("JetBrainsMono Nerd Font", 10), borderwidth=0)
        style.map("TButton", background=[("active", "#b4befe")])

        top = ttk.Frame(self.root)
        top.pack(fill="x", padx=10, pady=8)

        ttk.Label(top, text="  Wallpapers", font=("JetBrainsMono Nerd Font", 16)).pack(side="left")

        btn_frame = ttk.Frame(top)
        btn_frame.pack(side="right")
        ttk.Button(btn_frame, text="    Random  ",
            command=self.random_wall).pack(side="left", padx=2)
        ttk.Button(btn_frame, text="    Browse  ",
            command=self.browse).pack(side="left", padx=2)

        canvas = tk.Canvas(self.root, bg=self.bg, highlightthickness=0)
        scroll = ttk.Scrollbar(self.root, orient="vertical", command=canvas.yview)
        self.frame = ttk.Frame(canvas)
        self.frame.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.create_window((0, 0), window=self.frame, anchor="nw")
        canvas.configure(yscrollcommand=scroll.set)

        canvas.pack(side="left", fill="both", expand=True, padx=(10, 0), pady=(0, 10))
        scroll.pack(side="right", fill="y", pady=(0, 10))

        canvas.bind("<Button-4>", lambda e: canvas.yview_scroll(-3, "units"))
        canvas.bind("<Button-5>", lambda e: canvas.yview_scroll(3, "units"))
        canvas.bind("<MouseWheel>", lambda e: canvas.yview_scroll(int(-1*(e.delta/120)), "units"))

        self.images = []
        self.load_wallpapers()

        self.root.geometry("700x500")
        self.root.resizable(True, True)
        self.root.minsize(500, 300)

        self.root.mainloop()

    def _float_window(self):
        try:
            addr = subprocess.getoutput(
                'hyprctl activewindow -j | python3 -c "import json,sys; print(json.load(sys.stdin).get(\'address\',\'\'))"'
            )
            if addr:
                subprocess.run(f"hyprctl dispatch setfloating address:{addr}", shell=True, capture_output=True)
                subprocess.run(f"hyprctl dispatch centerwindow address:{addr}", shell=True, capture_output=True)
        except:
            pass

    def load_wallpapers(self):
        exts = ("*.jpg", "*.jpeg", "*.png", "*.gif", "*.bmp", "*.webp")
        files = []
        for ext in exts:
            files.extend(glob.glob(os.path.join(WALL_DIR, ext)))
            files.extend(glob.glob(os.path.join(WALL_DIR, ext.upper())))
        files.sort(key=lambda f: os.path.getmtime(f), reverse=True)

        if not files:
            ttk.Label(self.frame, text="No wallpapers found in ~/Pictures/wallpapers/",
                font=("JetBrainsMono Nerd Font", 13)).pack(pady=40)
            return

        cols = 3
        row_frame = None
        for i, path in enumerate(files):
            if i % cols == 0:
                row_frame = ttk.Frame(self.frame)
                row_frame.pack(fill="x", pady=4)
            self.add_thumb(row_frame, path)

    def add_thumb(self, parent, path):
        f = ttk.Frame(parent)
        f.pack(side="left", padx=6)

        try:
            img = Image.open(path)
            img.thumbnail(THUMB_SIZE, Image.LANCZOS)
            photo = ImageTk.PhotoImage(img)
            lbl = tk.Label(f, image=photo, bg=self.bg, cursor="hand2")
            lbl.image = photo
        except:
            lbl = tk.Label(f, text="", bg=self.bg, fg=self.fg,
                font=("JetBrainsMono Nerd Font", 40), cursor="hand2")

        lbl.pack()
        lbl.bind("<Button-1>", lambda e, p=path: self.apply_wall(p))

        name = os.path.basename(path)[:25]
        ttk.Label(f, text=name, font=("JetBrainsMono Nerd Font", 8)).pack()

    def apply_wall(self, path):
        set_wallpaper(path)
        self.root.after(100, self.root.destroy)

    def random_wall(self):
        subprocess.Popen(f"{HOME}/.local/bin/wallpaper --random", shell=True)
        self.root.after(100, self.root.destroy)

    def browse(self):
        subprocess.Popen(f"kitty yazi {WALL_DIR}", shell=True)
        self.root.after(100, self.root.destroy)

if __name__ == "__main__":
    WallpaperPicker()
