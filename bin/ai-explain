#!/usr/bin/env bash
# Explain selected text using Mistral AI
# Usage: select text, run ai-explain
# Or: ai-explain "text"

MISTRAL_API_KEY="${MISTRAL_API_KEY:-}"
[ -z "$MISTRAL_API_KEY" ] && echo "Error: MISTRAL_API_KEY not set" >&2 && exit 1

if [ -n "$*" ]; then
    TEXT="$*"
elif command -v wl-paste &>/dev/null; then
    TEXT=$(wl-paste --primary 2>/dev/null || wl-paste 2>/dev/null)
fi

[ -z "$TEXT" ] && echo "No text selected" >&2 && exit 1

RESPONSE=$(curl -s https://api.mistral.ai/v1/chat/completions \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $MISTRAL_API_KEY" \
    -d "$(jq -n --arg text "$TEXT" '{
        model: "mistral-small-latest",
        messages: [
            {role: "system", content: "You are a code/terminal output explainer. Briefly explain what this is and what it does."},
            {role: "user", content: $text}
        ],
        max_tokens: 1024
    }')" 2>/dev/null)

echo "$RESPONSE" | jq -r '.choices[0].message.content // "Error"'
