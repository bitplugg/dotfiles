#!/usr/bin/env python3
import json, os, subprocess
import tkinter as tk
from tkinter import ttk, colorchooser

HOME = os.path.expanduser("~")
WAL_JSON = f"{HOME}/.cache/wal/colors.json"

def wal_color(name):
    try:
        with open(WAL_JSON) as f:
            c = json.load(f)
        return c["colors"][name].lstrip("#")
    except:
        return "1e1e2e" if "bg" in name else "cdd6f4"

class SettingsApp:
    def __init__(self):
        self.root = tk.Tk(className="Settings")
        self.root.title("Settings")
        self.root.geometry("780x540")
        self.root.resizable(False, False)
        self.root.after(200, self._float_window)

        self.bg = "#" + wal_color("color0")
        self.fg = "#" + wal_color("color7")
        self.accent = "#" + wal_color("color4")
        self.surface = "#" + wal_color("color0")
        self.root.configure(bg=self.bg)

        style = ttk.Style()
        style.theme_use("clam")
        style.configure("TNotebook", background=self.bg, borderwidth=0, padding=0)
        style.configure("TNotebook.Tab", background=self.surface, foreground=self.fg,
                        padding=[16, 6], font=("JetBrainsMono Nerd Font", 11))
        style.map("TNotebook.Tab", background=[("selected", self.accent)],
                  foreground=[("selected", "#000000")])
        style.configure("TFrame", background=self.bg)
        style.configure("TLabel", background=self.bg, foreground=self.fg,
                        font=("JetBrainsMono Nerd Font", 11))
        style.configure("Bold.TLabel", background=self.bg, foreground=self.fg,
                        font=("JetBrainsMono Nerd Font", 12, "bold"))
        style.configure("TButton", background=self.accent, foreground="#000000",
                        font=("JetBrainsMono Nerd Font", 10, "bold"),
                        borderwidth=0, padding=[14, 6])
        style.map("TButton", background=[("active", "#" + wal_color("color6"))])
        style.configure("TScale", background=self.bg, troughcolor="#" + wal_color("color8"))
        style.configure("TCheckbutton", background=self.bg, foreground=self.fg,
                        font=("JetBrainsMono Nerd Font", 11))
        style.configure("Red.TButton", background="#3C4346", foreground="#c1c2c3",
                        font=("JetBrainsMono Nerd Font", 10, "bold"),
                        borderwidth=0, padding=[14, 6])
        style.map("Red.TButton", background=[("active", "#" + wal_color("color1"))])
        style.configure("Green.TButton", background="#4A5254", foreground="#c1c2c3",
                        font=("JetBrainsMono Nerd Font", 10, "bold"),
                        borderwidth=0, padding=[14, 6])
        style.map("Green.TButton", background=[("active", "#" + wal_color("color2"))])

        notebook = ttk.Notebook(self.root)
        notebook.pack(fill="both", expand=True, padx=12, pady=12)

        self.page_theme(notebook)
        self.page_display(notebook)
        self.page_audio(notebook)
        self.page_power(notebook)
        self.page_dotfiles(notebook)
        self.page_info(notebook)

        self.root.mainloop()

    def add_page(self, notebook, title):
        frame = ttk.Frame(notebook)
        notebook.add(frame, text=title)
        return frame

    def section(self, parent, text):
        ttk.Label(parent, text=text, style="Bold.TLabel").pack(pady=(14, 4))

    def btn(self, parent, text, cmd, style="TButton"):
        b = ttk.Button(parent, text=text, command=cmd, style=style)
        b.pack(pady=3)
        return b

    def _float_window(self):
        try:
            addr = subprocess.getoutput(
                "hyprctl activewindow -j | python3 -c "
                "\"import json,sys; print(json.load(sys.stdin).get('address',''))\""
            )
            if addr:
                subprocess.run(f"hyprctl dispatch setfloating address:{addr}", shell=True, capture_output=True)
                subprocess.run(f"hyprctl dispatch centerwindow address:{addr}", shell=True, capture_output=True)
                subprocess.run(f"hyprctl dispatch resizewindowpixel exact 780 540,address:{addr}", shell=True, capture_output=True)
        except:
            pass

    # ── Pages ──

    def page_theme(self, notebook):
        f = self.add_page(notebook, "    Theme  ")

        self.section(f, "Wallpaper")
        self.btn(f, "    Change wallpaper", lambda: run("kitty ~/.local/bin/wallpaper-picker"))
        self.btn(f, "  辰  Random wallpaper", lambda: run("~/.local/bin/random-wallpaper"))

        self.section(f, "Colors")
        self.btn(f, "    Regenerate from wallpaper", lambda: run("~/.local/bin/pywal-update-all"))
        self.btn(f, "    Edit palette manually", lambda: run("kitty -e ~/.local/bin/colors-edit"))
        self.btn(f, "    Show palette", lambda: run("kitty -e pywal-swatch"))

        self.section(f, "Interface")
        self.btn(f, "    GTK settings (nwg-look)", lambda: run("nwg-look"))

    def page_display(self, notebook):
        f = self.add_page(notebook, "    Display  ")

        self.section(f, "Brightness")
        bright = tk.DoubleVar(value=get_brightness())
        scale = ttk.Scale(f, from_=1, to=100, variable=bright,
                          command=lambda v: set_brightness(int(float(v))))
        scale.pack(fill="x", padx=50, pady=2)
        ttk.Label(f, textvariable=bright).pack()

        self.section(f, "Screen effects")
        self.btn(f, "    Toggle blur (hyprlock)", lambda: toggle_blur())
        self.btn(f, "  ﱿ  Toggle animations", lambda: toggle_animations())
        self.btn(f, "    Toggle night mode", lambda: run("~/.local/bin/night-mode"))

        self.section(f, "Monitors")
        self.btn(f, "    Display manager", lambda: run("~/.local/bin/display-manager"))

    def page_audio(self, notebook):
        f = self.add_page(notebook, "    Audio  ")

        self.section(f, "Volume")
        vol = tk.DoubleVar(value=get_volume())
        scale = ttk.Scale(f, from_=0, to=150, variable=vol,
                          command=lambda v: set_volume(int(float(v))))
        scale.pack(fill="x", padx=50, pady=2)
        ttk.Label(f, textvariable=vol).pack()

        self.btn(f, "    Toggle mute",
                 lambda: run("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"))
        self.btn(f, "    Toggle mic",
                 lambda: run("~/.local/bin/mic-toggle"))

        self.section(f, "Mixer")
        self.btn(f, "  蓼  TUI mixer (pulsemixer)",
                 lambda: run("kitty -e pulsemixer"))
        self.btn(f, "  蓼  GUI mixer (pavucontrol)",
                 lambda: run("pavucontrol"))

    def page_power(self, notebook):
        f = self.add_page(notebook, "    Power  ")

        self.section(f, "Power profile")
        self.btn(f, "    Switch CPU governor",
                 lambda: run("~/.local/bin/power-profile"))

        self.section(f, "Idle management")
        self.btn(f, "    Edit idle config",
                 lambda: run(f"kitty -e nvim {HOME}/.config/hypr/hypridle.conf"))
        self.btn(f, "    Toggle idle inhibit",
                 lambda: run("~/.local/bin/idle-inhibit"))

        self.section(f, "Session")
        self.btn(f, "    Lock screen", lambda: run("hyprlock"))
        bf = ttk.Frame(f)
        bf.pack(pady=6)
        ttk.Button(bf, text="    Reboot  ", command=lambda: run("systemctl reboot"),
                   style="Red.TButton").pack(side="left", padx=6)
        ttk.Button(bf, text="    Shutdown  ", command=lambda: run("systemctl poweroff"),
                   style="Red.TButton").pack(side="left", padx=6)

    def page_dotfiles(self, notebook):
        f = self.add_page(notebook, "    Dotfiles  ")

        self.section(f, "Repository")
        self.btn(f, "    Open dotfiles TUI updater",
                 lambda: run("kitty -e ~/.local/bin/dotfiles-updater"))
        self.btn(f, "    Quick commit + push",
                 lambda: quick_sync())

        self.section(f, "Status")
        status = subprocess.getoutput(
            "cd ~/dotfiles 2>/dev/null && git status --short 2>/dev/null | head -20 || echo 'N/A'"
        )
        text = tk.Text(f, wrap="none", bg=self.surface, fg=self.fg,
                       font=("JetBrainsMono Nerd Font", 10), relief="flat",
                       bd=0, padx=10, pady=10, height=6)
        text.insert("1.0", status if status else "✓ Up to date")
        text.configure(state="disabled")
        text.pack(fill="both", expand=True, padx=10, pady=4)

        self.section(f, "Tools")
        bf = ttk.Frame(f)
        bf.pack(pady=4)
        ttk.Button(bf, text="    Status  ",
                   command=lambda: run("kitty -e bash -c 'cd ~/dotfiles && git status && read'")
                   ).pack(side="left", padx=4)
        ttk.Button(bf, text="    Log  ",
                   command=lambda: run("kitty -e bash -c 'cd ~/dotfiles && git log --oneline -20 && read'")
                   ).pack(side="left", padx=4)
        ttk.Button(bf, text="    Push  ",
                   command=lambda: run("cd ~/dotfiles && git push"))
        bf2 = ttk.Frame(f)
        bf2.pack(pady=4)
        ttk.Button(bf2, text="    Open in lazygit  ",
                   command=lambda: run("kitty -e bash -c 'cd ~/dotfiles && lazygit'")
                   ).pack(side="left", padx=4)

        self.section(f, "Install / Update")
        self.btn(f, "    Re-run install.sh",
                 lambda: run("kitty -e bash ~/dotfiles/install.sh"))

    def page_info(self, notebook):
        f = self.add_page(notebook, "    Info  ")
        info = subprocess.getoutput(
            "fastfetch --pipe -s title -s os -s kernel -s uptime -s packages "
            "-s shell -s de -s theme -s icons -s font -s gpu -s cpu -s memory 2>/dev/null | head -20"
        )
        text = tk.Text(f, wrap="word", bg=self.surface, fg=self.fg,
                       font=("JetBrainsMono Nerd Font", 10), relief="flat",
                       bd=0, padx=12, pady=12)
        text.insert("1.0", info)
        text.configure(state="disabled")
        text.pack(fill="both", expand=True, padx=10, pady=10)

def run(cmd):
    subprocess.Popen(f"exec {cmd}", shell=True)

def quick_sync():
    os.chdir(f"{HOME}/dotfiles")
    r = subprocess.run("git status --short", shell=True, capture_output=True, text=True)
    if not r.stdout.strip():
        subprocess.run(["notify-send", "Dotfiles", "Nothing to commit"])
        return
    subprocess.run(
        f"cd {HOME}/dotfiles && git add -A && git commit -m 'sync $(date +%H:%M)' && git push",
        shell=True, capture_output=True
    )
    subprocess.run(["notify-send", "Dotfiles", "Committed and pushed"])

def get_brightness():
    try:
        out = subprocess.getoutput("brightnessctl get")
        max_ = subprocess.getoutput("brightnessctl max")
        if max_ and max_.isdigit() and int(max_) > 0:
            return int(int(out) / int(max_) * 100)
    except:
        pass
    return 80

def set_volume(v):
    subprocess.run(f"wpctl set-volume @DEFAULT_AUDIO_SINK@ {v}%", shell=True)

def get_volume():
    try:
        out = subprocess.getoutput("wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $2*100}'")
        return int(float(out))
    except:
        return 50

def set_brightness(v):
    subprocess.run(f"brightnessctl set {v}% && swayosd-client --brightness {v}", shell=True)

def toggle_blur():
    hypr = f"{HOME}/.config/hypr/hyprlock.conf"
    try:
        with open(hypr) as f:
            c = f.read()
        if "blur_passes = 0" in c:
            c = c.replace("blur_passes = 0", "blur_passes = 4")
            subprocess.run(["notify-send", "Blur", "Enabled"])
        else:
            c = c.replace("blur_passes = 4", "blur_passes = 0")
            subprocess.run(["notify-send", "Blur", "Disabled"])
        with open(hypr, "w") as f:
            f.write(c)
    except:
        pass

def toggle_animations():
    anim = f"{HOME}/.config/hypr/animations.conf"
    try:
        with open(anim) as f:
            c = f.read()
        if "enabled = true" in c:
            c = c.replace("enabled = true", "enabled = false")
            subprocess.run(["notify-send", "Animations", "Disabled"])
        else:
            c = c.replace("enabled = false", "enabled = true")
            subprocess.run(["notify-send", "Animations", "Enabled"])
        with open(anim, "w") as f:
            f.write(c)
    except:
        pass

if __name__ == "__main__":
    SettingsApp()
