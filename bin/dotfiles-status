#!/usr/bin/env bash
# Show dotfiles repo status — uncommitted, unpushed, branch info

cd "$HOME/dotfiles" 2>/dev/null || { echo "dotfiles repo not found"; exit 1; }

BRANCH=$(git branch --show-current)
PUSHED=$(git log --oneline "@{upstream}..HEAD" 2>/dev/null | wc -l)
PULL=$(git log --oneline "HEAD..@{upstream}" 2>/dev/null | wc -l)

echo " dotfiles ($BRANCH)"

if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
    echo "   Uncommitted changes:"
    git status --short 2>/dev/null | while read -r line; do
        echo "    $line"
    done
fi

if [ "$PUSHED" -gt 0 ]; then
    echo "   $PUSHED commits to push"
fi

if [ "$PULL" -gt 0 ]; then
    echo "   $PULL commits to pull"
fi

if [ -z "$(git status --porcelain 2>/dev/null)" ] && [ "$PUSHED" -eq 0 ] && [ "$PULL" -eq 0 ]; then
    echo "   Up to date"
fi

echo ""
echo "  Last commit: $(git log -1 --format='%h %s' 2>/dev/null)"
