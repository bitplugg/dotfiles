#!/usr/bin/env bash
# Waybar custom module: night mode status
PID_FILE="/tmp/wlsunset.pid"
if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    echo '{"text": "", "class": "enabled", "tooltip": "Night mode on"}'
else
    echo '{"text": "", "class": "disabled", "tooltip": "Night mode off"}'
fi
