#!/usr/bin/env bash
# Power profile switcher via wofi

CURRENT=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "unknown")

CHOICE=$(printf "performance\nondemand\nconservative\nschedutil\npowersave" | \
    wofi --dmenu -p "Power: $CURRENT")

[ -z "$CHOICE" ] && exit 0

if echo "$CHOICE" | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor 2>/dev/null; then
    notify-send "Power profile" "$CHOICE"
    echo "CPU governor set to: $CHOICE"
else
    pkexec bash -c "echo '$CHOICE' | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor" 2>/dev/null
    if [ $? -eq 0 ]; then
        notify-send "Power profile" "$CHOICE"
        echo "CPU governor set to: $CHOICE"
    else
        notify-send -u critical "Power profile" "Failed to set $CHOICE (need sudo)"
        exit 1
    fi
fi
