#!/usr/bin/env bash

set_wallpaper() {
    local IMAGE="$1"
    if command -v awww &>/dev/null; then
        awww img "$IMAGE" --transition-fps 60 --transition-duration 2
    elif command -v swww &>/dev/null; then
        swww img "$IMAGE" --transition-fps 60 --transition-duration 2
    fi
    if command -v wal &>/dev/null; then
        wal -i "$IMAGE" -n -q
    fi
    if command -v pywal-update-all &>/dev/null; then
        pywal-update-all
    fi
}

WALLPAPER_DIR="$HOME/Pictures/wallpapers"

if [ ! -d "$WALLPAPER_DIR" ]; then
    echo "Wallpaper directory $WALLPAPER_DIR does not exist"
    exit 1
fi

if [ "$1" = "--random" ]; then
    IMAGE=$(find "$WALLPAPER_DIR" -type f \( -name '*.jpg' -o -name '*.png' -o -name '*.jpeg' \) | shuf -n 1)
    [ -z "$IMAGE" ] && echo "No images found" && exit 1
    set_wallpaper "$IMAGE"
    exit 0
fi

TMPFILE=$(mktemp)
yazi --chooser-file="$TMPFILE" "$WALLPAPER_DIR" 2>/dev/null
SELECTED=$(cat "$TMPFILE")
rm -f "$TMPFILE"

[ -z "$SELECTED" ] && exit 0

set_wallpaper "$SELECTED"
