 Badge -"

SELECTED=$(echo "$ICONS" | ~/.local/bin/dmenu -p "Nerd Icons" -theme-str 'listview {columns: 3;}')
[ -z "$SELECTED" ] && exit 0
ICON=$(echo "$SELECTED" | awk '{print $1}')
NAME=$(echo "$SELECTED" | cut -d' ' -f2-)
echo -n "$ICON" | wl-copy
notify-send "Nerd Icon" "Copied: $ICON ($NAME)"
